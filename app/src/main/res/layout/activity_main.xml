<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mustard"
    tools:context=".MainActivity">

    <!-- App name in the toolbar, same font and colour as the splash screen -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/cream"
        android:elevation="4dp"
        android:theme="@style/Depack.ToolbarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="Depackaged"
        app:titleTextAppearance="@style/Depack.ToolbarTitle" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvGreeting"
                style="@style/Depack.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hi, username"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvSubGreeting"
                style="@style/Depack.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ready to read between the labels?" />

            <Button
                android:id="@+id/btnScan"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/cream"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="SCAN A BARCODE"
                android:textColor="@color/app_red"
                android:textSize="26sp"
                android:textStyle="bold"
                app:strokeColor="@color/app_red"
                app:strokeWidth="2dp" />

            <TextView
                android:id="@+id/tvOr"
                style="@style/Depack.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="or type the barcode number below" />

            <EditText
                android:id="@+id/etBarcode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:fontFamily="sans-serif-condensed-medium"
                android:hint="Barcode number (13 digits)"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="13"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/app_red"
                android:textColorHint="#80FF0000"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cream"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="Check this product"
                android:textColor="@color/app_red"
                android:textSize="18sp"
                android:textStyle="bold"
                app:strokeColor="@color/app_red"
                app:strokeWidth="2dp" />

            <!-- History button, right on the main screen -->
            <Button
                android:id="@+id/btnHistory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/cream"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="Check your history"
                android:textColor="@color/app_red"
                android:textSize="18sp"
                android:textStyle="bold"
                app:strokeColor="@color/app_red"
                app:strokeWidth="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvFactTitle"
                    style="@style/Depack.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Did you know?" />

                <TextView
                    android:id="@+id/tvFact"
                    style="@style/Depack.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="A habit-building fact appears here." />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>