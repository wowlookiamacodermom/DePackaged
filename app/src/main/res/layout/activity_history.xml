<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mustard"
    tools:context=".HistoryActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/cream"
        android:elevation="4dp"
        android:theme="@style/Depack.ToolbarTheme"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:title="Scan history"
        app:titleTextAppearance="@style/Depack.ToolbarTitle" />

    <!-- Filters: rating spinner + date picker button -->
    <LinearLayout
        android:id="@+id/filterRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <Spinner
            android:id="@+id/spFilter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:entries="@array/rating_filter"
            android:paddingStart="8dp" />

        <Button
            android:id="@+id/btnPickDate"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/cream"
            android:fontFamily="sans-serif-condensed-medium"
            android:text="Pick date"
            android:textColor="@color/app_red"
            android:textSize="16sp"
            android:textStyle="bold"
            app:strokeColor="@color/app_red"
            app:strokeWidth="2dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDateSelected"
        style="@style/Depack.Small"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Showing scans from all dates"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filterRow" />

    <ListView
        android:id="@+id/lvHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_card"
        android:divider="@color/app_red"
        android:dividerHeight="1dp"
        app:layout_constraintBottom_toTopOf="@id/btnClearHistory"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDateSelected" />

    <TextView
        android:id="@+id/tvEmpty"
        style="@style/Depack.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No scans yet. Go scan something!"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/lvHistory"
        app:layout_constraintEnd_toEndOf="@id/lvHistory"
        app:layout_constraintStart_toStartOf="@id/lvHistory"
        app:layout_constraintTop_toTopOf="@id/lvHistory" />

    <Button
        android:id="@+id/btnClearHistory"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/cream"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="Clear history"
        android:textColor="@color/app_red"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/app_red"
        app:strokeWidth="2dp" />

</androidx.constraintlayout.widget.ConstraintLayout>